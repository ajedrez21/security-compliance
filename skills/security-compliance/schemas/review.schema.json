{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "security-compliance agent review",
  "description": "Revisión estructurada del agente (Cursor, Claude Code, Codex). Conserva siempre la procedencia agent_review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "created_at", "snapshot", "control_results"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client"],
      "properties": {
        "client": {"type": "string", "maxLength": 100},
        "model": {"type": "string", "maxLength": 100},
        "session": {"type": "string", "maxLength": 200}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
        "run_id": {"type": "string", "maxLength": 80}
      }
    },
    "scope_reviewed": {"type": "array", "items": {"type": "string", "maxLength": 500}},
    "control_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "status", "rationale"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$"},
          "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
          "rationale": {"type": "string", "minLength": 10, "maxLength": 3000},
          "files_examined": {"type": "array", "items": {"type": "string", "maxLength": 500}},
          "finding_refs": {"type": "array", "items": {"type": "string", "maxLength": 80}},
          "limitations": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "control_id", "title", "severity", "confidence", "description", "file"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "control_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 300},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "file": {"type": "string", "minLength": 1, "maxLength": 500},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 10, "maxLength": 3000},
        "flow": {"type": "string", "maxLength": 2000, "description": "Entrada → flujo → operación sensible → control existente → condición de explotación."},
        "evidence": {"type": "string", "maxLength": 1000},
        "risk": {"type": "string", "maxLength": 1000},
        "remediation": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
